# Copy this file to .env for local development.
# All services below are provided by Docker Compose (docker compose up).

# PostgreSQL (Docker Compose maps postgres:5432 → localhost:5433)
DATABASE_URL=postgresql://dipstick:dipstick@localhost:5433/dipstick

# Redis (Docker Compose maps redis:6379 → localhost:6380)
REDIS_URL=redis://localhost:6380

# Simulated OIDC provider (Docker Compose runs on port 4011)
OIDC_ISSUER=http://localhost:4011
OIDC_CLIENT_ID=dipstick-local
OIDC_CLIENT_SECRET=dipstick-local-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Role map: IdP claim values -> internal roles (application_admin,
# engineering_manager, facilitator, senior_engineer). Leave commented out for
# local dev: with a local OIDC_ISSUER and a non-production NODE_ENV the
# built-in identity map is used, which the stub's manager-001, admin-001 and
# facilitator-001 accounts rely on. REQUIRED for any non-local OIDC_ISSUER and
# in production (see docs/deployment.md). Example for a `groups` claim:
# OIDC_ROLE_CLAIM=groups
# OIDC_ROLE_MAP={"Eng-Managers":"engineering_manager","Retro-Facilitators":"facilitator","Dipstick-Admins":"application_admin"}

# Session cookie signing key — any long random string is fine for local dev
SESSION_SECRET=local-dev-session-secret-change-in-production

# Token encryption key for refresh tokens stored in Redis (optional; falls back to SESSION_SECRET)
# TOKEN_ENCRYPTION_KEY=your-token-encryption-key-here

# Application origin for CORS in production (required when NODE_ENV=production)
# APP_ORIGIN=https://dipstick.example.com

# Application environment
NODE_ENV=development
PORT=3000
